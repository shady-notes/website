---
import { Image } from "astro:assets";
import poster from "~/assets/film/brand-film-poster.webp";
import { siteConfig } from "~/config/site";

/*
  The two-minute brand film (feature 008), in the slot the screenshot slider
  used to hold: the film is itself a chaptered tour of the same screens.

  Playback rules (DESIGN.md, motion budget):
    * Muted, and only while at least half the frame is on screen. It pauses
      when scrolled away or the tab is hidden, and resumes where it was.
    * Plays once and rests on the logo end card. No loop.
    * Never starts by itself on a phone (< 768px), under prefers-reduced-motion
      or Save-Data: the poster and a Play button stand in until the reader asks.
    * A visible pause control at all times (WCAG 2.2.2).

  Bytes: nothing loads with the page. preload="none", the poster is a lazy
  <img> (not the `poster` attribute, which fetches eagerly and has no srcset),
  and the frame reserves its 16:9 box so nothing shifts.

  No green grade over the frame, unlike the slider thumbnails: the film is
  already in the brand palette, and its product shots are full-size, where a
  tint would misrepresent the app.
*/
const { hero = false } = Astro.props;
const { base, src1080, src720, duration } = siteConfig.film;
const url1080 = `${base}/${src1080}`;
const url720 = `${base}/${src720}`;

// The film's on-screen copy, chapter by chapter, from its storyboard
// (brand/promo-videos/shadynotes-brand-film-2min/STORYBOARD.md). It has no
// speech, so this is its text equivalent.
const chapters = [
  "A notepad that lives just above your screen. Shady Notes, for Mac.",
  "Scroll down near the top of any screen and the shade comes down. Or press ⌃⌥⌘↓. Scroll up: gone.",
  "Four chapters: write, organise, extend, own it.",
  "Write: live markdown, slash commands, real tables, checkboxes that stay - [x] on disk.",
  "Callouts in nine types, and [[wikilinks]] the way Obsidian does them.",
  "Organise: vault search, workspaces with a colour and a folder each, find and replace, the sidebar.",
  "Every note is a plain .md file. Open them in VS Code, grep or Obsidian.",
  "No lock-in. No database, just your disk.",
  "Extend: plugins, Daily Notes, a Kanban board that is still a .md file, and Tasks.",
  "Own it: sixteen themes, and ⌃E to see the raw markdown as it is on disk.",
  "Pay for the app, never for your notes. Free, Personal at US$4 a month, Supporter at US$8 a month.",
  "Shady Notes. Your notes, one scroll away. Free with a 14-day full trial, macOS 13 and later. Made by Round Rect.",
];

const icon = {
  play: "M8 5.5v13l11-6.5z",
  pause: "M8 5v14M16 5v14",
  replay: "M3 12a9 9 0 1 0 3-6.7M3 4v5h5",
};
---

<section id="film" class:list={[!hero && "border-b border-brand-line"]} aria-labelledby="film-heading">
  <div class:list={["mx-auto max-w-6xl", !hero && "px-6 py-24"]}>
    <h2 id="film-heading" class="max-w-3xl font-sans text-3xl font-bold tracking-tight text-balance md:text-4xl">
      Two minutes with Shady Notes.
    </h2>
    <p class="mt-5 max-w-[60ch] text-base text-brand-fg/85 md:text-lg">
      The gesture, the editor, the plugins and the plain files underneath. On a
      laptop or desktop it plays muted when you scroll to it; on a phone, press
      play.
    </p>

    <figure class="film mt-10" data-film>
      <div class="film-frame">
        <Image
          src={poster}
          alt=""
          class="film-poster"
          widths={[640, 1104, 1600, 1920]}
          sizes="(min-width: 1152px) 1104px, calc(100vw - 3rem)"
          loading="lazy"
          data-film-poster
        />
        <video
          class="film-video"
          data-film-video
          controls
          preload="none"
          muted
          playsinline
          aria-label={`Shady Notes brand film, ${duration}, music only, no speech`}
          aria-describedby="film-text"
        >
          <source src={url1080} type="video/mp4" media="(min-width: 768px)" />
          <source src={url720} type="video/mp4" />
        </video>

        <button type="button" class="film-big" data-film-big hidden aria-label="Play film">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path class="film-big-play" d={icon.play} fill="currentColor"></path>
            <path
              class="film-big-replay"
              d={icon.replay}
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </button>

      </div>

      <figcaption class="film-caption">
        <div class="film-bar">
          <div class="film-controls" data-film-controls hidden>
            <button type="button" class="film-btn" data-film-toggle aria-label="Play film">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path class="film-i-play" d={icon.play} fill="currentColor"></path>
                <path class="film-i-pause" d={icon.pause} stroke="currentColor" stroke-width="2.5" stroke-linecap="round"></path>
              </svg>
            </button>
            <button type="button" class="film-btn" data-film-mute aria-label="Unmute">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z" fill="currentColor"></path>
                <path class="film-i-muted" d="M16 9.5l5 5M21 9.5l-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
                <path class="film-i-sound" d="M16 8.5a5 5 0 0 1 0 7M18.5 6a8.5 8.5 0 0 1 0 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
              </svg>
            </button>
            <button type="button" class="film-btn" data-film-full aria-label="Full screen">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M4 9V4h5M15 4h5v5M20 15v5h-5M9 20H4v-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </button>
          </div>
          <p class="font-mono text-xs text-brand-muted" data-film-status>
            {duration} · music only, no voiceover
          </p>
        </div>
        <details id="film-text" class="film-text">
          <summary>Read the film as text</summary>
          <ol>
            {chapters.map((c) => <li>{c}</li>)}
          </ol>
        </details>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .film {
    margin-inline: 0;
    margin-bottom: 0;
  }

  .film-frame {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    isolation: isolate;
    border: 1px solid var(--color-brand-line);
    border-radius: 0.75rem;
    background: var(--color-brand-bg-soft);
    box-shadow: 0 4px 0 #000;
  }

  .film-poster,
  .film-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .film-poster {
    z-index: 0;
    object-fit: cover;
    transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .film.is-started .film-poster {
    opacity: 0;
  }

  .film-video {
    z-index: 1;
    object-fit: contain;
    background: transparent;
  }

  /* Until it has played, the video has no frame of its own; the poster shows
     through it. Once enhanced, clicks on the picture toggle playback. */
  .film.is-enhanced .film-video {
    cursor: pointer;
  }

  .film-big,
  .film-btn {
    display: grid;
    place-items: center;
    border-radius: 999px;
    border: 1px solid var(--color-brand-line);
    background: color-mix(in srgb, var(--color-brand-bg) 85%, transparent);
    color: var(--color-brand-fg);
    cursor: pointer;
    transition:
      border-color 0.15s,
      background-color 0.15s;
  }

  .film-big:hover,
  .film-btn:hover {
    border-color: color-mix(in srgb, var(--color-brand-accent) 50%, transparent);
    background: var(--color-brand-bg);
  }

  .film-big {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 3;
    width: 4rem;
    height: 4rem;
    translate: -50% -50%;
  }

  .film-big .film-big-replay,
  .film.is-ended .film-big .film-big-play {
    display: none;
  }

  .film.is-ended .film-big .film-big-replay {
    display: inline;
  }

  /* Below the picture, not over it: the film sets its own titles in the
     bottom-left corner, and on a phone three 44px buttons would cover a
     third of the frame. */
  .film-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
  }

  .film-controls {
    display: flex;
    gap: 0.5rem;
  }

  .film-btn {
    width: 2.75rem;
    height: 2.75rem;
  }

  .film-i-pause,
  .film.is-playing .film-i-play,
  .film-i-sound,
  .film.is-unmuted .film-i-muted {
    display: none;
  }

  .film.is-playing .film-i-pause,
  .film.is-unmuted .film-i-sound {
    display: inline;
  }

  /* `hidden` only maps to display:none in the UA sheet, and the display
     rules above outrank it — the trap the slider and docs zoom both hit. */
  .film-big[hidden],
  .film-controls[hidden] {
    display: none;
  }

  .film-caption {
    margin-top: 0.75rem;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
  }

  .film-text {
    font-size: 0.875rem;
    color: var(--color-brand-muted);
  }

  .film-text summary {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    cursor: pointer;
    color: var(--color-brand-accent);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  .film-text ol {
    margin: 0.5rem 0 0;
    padding-left: 1.25rem;
    max-width: 65ch;
    list-style: decimal;
    line-height: 1.6;
    color: color-mix(in srgb, var(--color-brand-fg) 80%, transparent);
  }

  .film-text li + li {
    margin-top: 0.375rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .film-poster {
      transition: none;
    }
  }
</style>

<script>
  type Conn = { saveData?: boolean };

  document.querySelectorAll<HTMLElement>("[data-film]").forEach((film) => {
    const video = film.querySelector<HTMLVideoElement>("[data-film-video]");
    const big = film.querySelector<HTMLButtonElement>("[data-film-big]");
    const controls = film.querySelector<HTMLElement>("[data-film-controls]");
    const toggle = film.querySelector<HTMLButtonElement>("[data-film-toggle]");
    const mute = film.querySelector<HTMLButtonElement>("[data-film-mute]");
    const full = film.querySelector<HTMLButtonElement>("[data-film-full]");
    const status = film.querySelector<HTMLElement>("[data-film-status]");
    if (!video || !big || !controls || !toggle || !mute || !full) return;

    const saveData = Boolean((navigator as Navigator & { connection?: Conn }).connection?.saveData);
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    // Phones don't autoplay: on a ~180px-tall frame the product shots are
    // unreadable, and 8.8 MB over cellular is a lot to spend on a reader who
    // didn't ask. They get the poster and the Play button instead.
    const wide = window.matchMedia("(min-width: 768px)").matches;
    const allowAuto = !reduced && !saveData && wide;

    let inView = false;
    let userPaused = false;
    let ended = false;

    // Enhance: the native controls were only the no-JS fallback.
    video.controls = false;
    controls.hidden = false;
    film.classList.add("is-enhanced");
    if (!allowAuto) big.hidden = false;

    // Pick the rendition here rather than trusting <source media>: Chrome
    // ignored it in testing and took the 720p file at 1440px. The <source>
    // pair stays in the markup for the no-JS fallback. Setting src with
    // preload="none" fetches nothing until play().
    const sources = [...video.querySelectorAll("source")].map((s) => s.getAttribute("src") ?? "");
    const chosen = saveData || !wide ? sources[1] : sources[0];
    if (chosen) {
      video.querySelectorAll("source").forEach((s) => s.remove());
      video.src = chosen;
    }

    function play() {
      if (!video) return;
      video.play().catch(() => {
        // Blocked (Low Power Mode, a browser policy): wait for the reader.
        if (big) big.hidden = false;
      });
    }

    function sync() {
      if (!video || !toggle || !mute || !big) return;
      const playing = !video.paused && !video.ended;
      film.classList.toggle("is-playing", playing);
      film.classList.toggle("is-unmuted", !video.muted);
      film.classList.toggle("is-ended", ended);
      toggle.setAttribute("aria-label", playing ? "Pause film" : "Play film");
      mute.setAttribute("aria-label", video.muted ? "Unmute" : "Mute");
      big.setAttribute("aria-label", ended ? "Replay film" : "Play film");
      if (playing) big.hidden = true;
    }

    function readerPlay() {
      if (!video) return;
      if (ended) {
        ended = false;
        video.currentTime = 0;
      }
      userPaused = false;
      play();
    }

    function readerToggle() {
      if (!video) return;
      if (video.paused || video.ended) {
        readerPlay();
      } else {
        userPaused = true;
        video.pause();
      }
    }

    big.addEventListener("click", readerPlay);
    toggle.addEventListener("click", readerToggle);
    video.addEventListener("click", readerToggle);
    mute.addEventListener("click", () => {
      video.muted = !video.muted;
      sync();
    });

    full.addEventListener("click", () => {
      const v = video as HTMLVideoElement & { webkitEnterFullscreen?: () => void };
      if (v.requestFullscreen) v.requestFullscreen().catch(() => {});
      else v.webkitEnterFullscreen?.();
    });
    // The custom bar sits outside the video, so in fullscreen the native
    // controls take over.
    document.addEventListener("fullscreenchange", () => {
      video.controls = document.fullscreenElement === video;
    });

    video.addEventListener("playing", () => {
      film.classList.add("is-started");
      sync();
    });
    video.addEventListener("pause", sync);
    video.addEventListener("volumechange", sync);
    video.addEventListener("ended", () => {
      ended = true;
      big.hidden = false;
      sync();
    });
    video.addEventListener("error", () => {
      controls.hidden = true;
      big.hidden = true;
      if (status) status.textContent = "The film is unavailable right now.";
    }, true);

    function maybeAuto() {
      if (!video) return;
      if (inView && !document.hidden) {
        if (allowAuto && !userPaused && !ended && video.paused) play();
      } else if (!video.paused) {
        // Off screen or in a background tab: pause, but this is not the
        // reader pausing, so it resumes on return.
        video.pause();
      }
    }

    if ("IntersectionObserver" in window) {
      new IntersectionObserver(
        ([entry]) => {
          inView = entry.isIntersecting;
          maybeAuto();
        },
        { threshold: 0.5 },
      ).observe(film.querySelector(".film-frame") ?? film);
    } else if (allowAuto) {
      big.hidden = false;
    }
    document.addEventListener("visibilitychange", maybeAuto);

    sync();
  });
</script>
