---
interface Props {
  question: string;
}
const { question } = Astro.props;
---

<details class="group border-b border-brand-line py-5 last:border-b-0">
  <summary class="flex cursor-pointer items-center justify-between gap-4 text-base font-medium text-brand-fg list-none [&::-webkit-details-marker]:hidden">
    <span>{question}</span>
    <span
      class="shrink-0 text-brand-muted transition-transform group-open:rotate-45"
      aria-hidden="true"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
        <path
          d="M12 5v14M5 12h14"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"></path>
      </svg>
    </span>
  </summary>
  <div class="mt-3 text-sm leading-relaxed text-brand-muted">
    <slot />
  </div>
</details>
