---
import { render } from "astro:content";
import Site from "~/layouts/Site.astro";
import NewsletterSignup from "~/components/NewsletterSignup.astro";
import { getPosts, formatDate, type Post } from "~/lib/blog";
import { TOPICS } from "~/config/blog";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content } = await render(post);
const isoDate = post.data.date.toISOString().slice(0, 10);
---

<Site
  title={`${post.data.title} — Shady Notes`}
  description={post.data.summary}
  ogType="article"
  publishedTime={post.data.date}
  noindex={post.isDraft}
>
  <article class="mx-auto max-w-3xl px-6 py-16 md:py-24">
    {
      post.isDraft && (
        <p class="draft-banner mb-8" role="note">
          Draft — visible only in <code>npm run dev</code>. It is not built, deployed or mailed until
          <code>status: published</code>.
        </p>
      )
    }
    <header class="border-b border-brand-line pb-8">
      <p class="font-mono text-xs text-brand-muted">
        <time datetime={isoDate}>{formatDate(post.data.date)}</time>
        {" · "}
        {post.data.topics.map((t) => TOPICS[t].label).join(", ")}
      </p>
      <h1 class="mt-3 font-sans text-4xl font-bold tracking-tight md:text-5xl">{post.data.title}</h1>
      <p class="mt-5 text-lg text-brand-fg/85">{post.data.summary}</p>
    </header>

    <div class="post-body mt-10">
      <Content />
    </div>

    <p class="mt-12 border-t border-brand-line pt-6 text-sm">
      <a href="/blog/" class="underline">← All posts</a>
    </p>

    <NewsletterSignup source={`post:${post.slug}`} heading="Get the next post by email" />
  </article>
</Site>
