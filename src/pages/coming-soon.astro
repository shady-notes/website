---
import Base from "~/layouts/Base.astro";
import Logo from "~/components/Logo.astro";
import { siteConfig } from "~/config/site";
---

<Base
  title="Shady Notes — coming soon"
  description="Shady Notes is launching soon. The menu-bar markdown notepad for your Mac — your notes, one scroll away."
>
  <main
    class="min-h-screen flex flex-col items-center justify-center text-center px-6 py-16"
  >
    <Logo size={72} class="text-brand-accent" />

    <p class="mt-8 font-mono text-sm text-brand-accent tracking-wide">
      <span class="text-brand-muted">~/notes</span> · one scroll away<span
        class="ml-0.5 inline-block w-2 animate-pulse">▋</span
      >
    </p>

    <h1
      class="mt-4 text-3xl sm:text-5xl font-semibold tracking-tight text-brand-fg"
    >
      Coming soon.
    </h1>

    <p class="mt-5 max-w-md text-lg text-brand-muted">
      The menu-bar markdown notepad for your Mac — it slides down like a window
      shade and keeps every note as a plain file on your disk. We're putting on
      the finishing touches.
    </p>

    <div class="mt-9">
      <a
        href={siteConfig.socials.discord}
        class="inline-flex items-center gap-2 rounded-md border border-brand-line bg-brand-bg px-5 py-2.5 text-sm font-medium text-brand-fg transition hover:border-brand-accent hover:text-brand-accent"
      >
        Join the community on Discord →
      </a>
    </div>

    <p class="mt-12 font-mono text-xs text-brand-muted">
      {siteConfig.name} · by {siteConfig.company}
    </p>
  </main>
</Base>
