---
import Base from "~/layouts/Base.astro";
import Nav from "~/components/Nav.astro";
import Footer from "~/components/Footer.astro";
import NewsletterPopup from "~/components/NewsletterPopup.astro";
import GoogleTag from "~/components/GoogleTag.astro";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogType?: "website" | "article";
  publishedTime?: Date;
  noindex?: boolean;
  hideNav?: boolean;
  hideFooter?: boolean;
  /** Pass "secondary" when the page's own content carries the amber CTA. */
  navCta?: "primary" | "secondary";
  /** Pass false on pages with a task to finish (sign-in, checkout, errors). */
  newsletterPopup?: boolean;
}

const {
  title,
  description,
  canonical,
  ogType,
  publishedTime,
  noindex,
  hideNav = false,
  hideFooter = false,
  navCta = "primary",
  newsletterPopup = true,
} = Astro.props;

// Recorded with the sign-up, e.g. "popup:/blog/callouts/". Trimmed to the
// Worker's source pattern (letters, digits, : / _ -, at most 80 characters).
const popupSource = `popup:${Astro.url.pathname}`.replace(/[^a-z0-9:/_-]/gi, "-").slice(0, 80);
---

<Base {title} {description} {canonical} {ogType} {publishedTime} {noindex}>
  <a class="skip-link" href="#main">Skip to content</a>
  {!hideNav && <Nav cta={navCta} />}
  <main id="main">
    <slot />
  </main>
  {!hideFooter && <Footer />}
  {newsletterPopup && <NewsletterPopup source={popupSource} />}
  <GoogleTag />
</Base>
